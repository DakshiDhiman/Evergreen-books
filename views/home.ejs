<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Evergreen Books | Home</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-[#F7F4EC] text-[#173D35] min-h-screen">
    <%- include('includes/nav.ejs') %>
     <main>

        <!-- Hero Section -->
        <section class="bg-[#DCE5D8] px-6 py-20 md:py-28">
            <div class="max-w-6xl mx-auto grid md:grid-cols-[1fr_1.2fr] gap-10 items-center">
                <div>
                    <p class="uppercase tracking-[0.25em] text-xs font-bold mb-4 text-[#78877C]">
                        For the love of a good book.
                    </p>
                    <h1 class="text-5xl md:text-7xl font-serif leading-tight mb-6">
                        Turn a page. Find a world.
                    </h1>
                    <p class="max-w-xl leading-7 text-[#344C45] mb-8">
                        Thoughtfully chosen books for curious minds, quiet moments, and adventures that begin with a single sentence.
                    </p>
                    <a href="/books"
                       class="inline-block bg-[#173D35] text-white px-7 py-3 rounded-md hover:bg-[#285548]">
                        Explore Books
                    </a>
                </div>               
<div class="bg-[#F7F4EC] border border-[#D8C6A5]   md:p-8 rounded-2xl h-85 w-full flex items-center justify-center ">
    <img
    src="/uploads/home.png"
    alt="Cozy reading corner"
    class="w-[650px] h-[450px] object-contain rounded-xl"
    >
</div>
            </div>
        </section>

        <!-- Recently Added Books -->
        <section class="max-w-6xl mx-auto px-6 py-16">
            <div class="flex flex-wrap justify-between items-end gap-4 mb-8">
                <div>
                    <p class="uppercase tracking-widest text-xs text-[#78877C] mb-2">
                        WORTH A LOOK
                    </p>
                    <h2 class="text-3xl md:text-4xl font-serif">
                        Discover Your Next Favourites
                    </h2>
                </div>
                <a href="/books" class="underline underline-offset-4">
                    View all books
                </a>
            </div>
            <% if (books.length) { %>
                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% books.forEach(book => { %>
                        <article class="bg-white rounded-xl overflow-hidden border border-[#DCE5D8]">
                            <!-- Book Image -->
                            <div class="h-64 bg-[#E8EDE5] flex items-center justify-center">
                                <% if (book.img) { %>
                                    <img
                                        src="<%= book.img %>"
                                        alt="<%= book.title %>"
                                        class="w-full h-full object-contain">
                                <% } else { %>
                                    <span class="text-6xl">📚</span>
                                <% } %>

                            </div>
                            <!-- Book Details -->
                            <div class="p-5">

                                <p class="text-xs uppercase tracking-widest text-[#78877C]">
                                    <%= book.category %>
                                </p>

                                <h3 class="text-2xl font-serif mt-2">
                                    <%= book.title %>
                                </h3>

                                <p class="text-sm text-[#78877C] mt-1">
                                    by <%= book.authorName || book.author || 'Unknown Author' %>
                                </p>

                                <% if (book.description) { %>
                                    <p class="text-sm text-[#344C45] leading-6 mt-3">
                                        <%= book.description %>
                                    </p>
                                <% } %>

                                <!-- Price and Cart Button -->
                                <div class="flex items-center justify-between mt-5 pt-4 border-t border-[#DCE5D8]">

                                    <p class="text-amber-800 font-bold text-lg">
                                        ₹<%= book.price %>
                                    </p>

                                    <% if (!(typeof isAdmin !== 'undefined' && isAdmin)) { %>

                                        <form action="/cart/add" method="POST" class="add-to-cart-form">

                                            <input type="hidden" name="bookId" value="<%= book._id %>">

                                            <button
                                                type="submit"
                                                class="w-10 h-10 flex items-center justify-center bg-[#173D35] text-white rounded-full hover:bg-[#285548] transition"
                                                aria-label="Add to cart"
                                                title="Add to cart">

                                                <i class="fa-solid fa-cart-shopping"></i>

                                            </button>

                                        </form>

                                    <% } %>

                                </div>

                            </div>

                        </article>

                    <% }) %>

                </div>

            <% } else { %>

                <div class="bg-white border border-[#DCE5D8] rounded-xl p-10 text-center">
                    <p class="text-xl font-semibold">
                        Your shelves are waiting.
                    </p>

                    <p class="mt-2 text-[#78877C]">
                        Log in as admin and add your first book.
                    </p>
                </div>

            <% } %>

        </section>

    </main>

    <%- include('includes/footer.ejs') %>

    <!-- Add to Cart Functionality -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            document.querySelectorAll('.add-to-cart-form').forEach(form => {

                form.addEventListener('submit', async function (event) {

                    event.preventDefault();

                    const button = form.querySelector('button');
                    const originalContent = button.innerHTML;

                    button.disabled = true;
                    button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

                    try {

                        const response = await fetch('/cart/add', {
                            method: 'POST',
                            body: new URLSearchParams(new FormData(form)),
                            headers: {
                                'Accept': 'application/json',
                                'Content-Type': 'application/x-www-form-urlencoded'
                            }
                        });

                        const result = await response.json();

                        if (!response.ok || !result.success) {
                            console.error(result.message || 'Unable to add book.');
                            button.innerHTML = originalContent;
                            return;
                        }

                        button.innerHTML = '<i class="fa-solid fa-check"></i>';
                        const badge = document.getElementById('cart-count-badge');

if (badge && typeof result.cartCount === 'number') {
    badge.textContent = result.cartCount;
    badge.classList.remove('hidden');
}

                        setTimeout(() => {
                            button.innerHTML = originalContent;
                        }, 1000);

                    } catch (error) {

                        console.error('Cart error:', error);
                        button.innerHTML = originalContent;

                    } finally {

                        button.disabled = false;

                    }

                });

            });

        });
    </script>

</body>
</html>
